# Copy to .env.local to override. All values are optional.

# Absolute URL of the deployed site (used for canonical + Open Graph tags).
# On Vercel this is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL.
VITE_SITE_URL=https://your-domain.example

# EmailJS (https://www.emailjs.com). These are public values, but env vars make rotation easy.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
